      "parameters": {
        "content": "## 1. Receive the request",
        "height": 300,
        "width": 1180,
        "color": 7
      },
      "id": "34329529-8861-5c15-a580-ddee2851bf10",
      "name": "Section: Receive the request",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Count working days (weekends and public holidays excluded), validate and check the balance\nconst f = $('Leave request form').first().json;\nconst policy = $('Set leave policy').first().json;\nconst emp = $('Look up employee').first().json || {};\nconst holidayItems = $('Get public holidays').all().map(i => i.json);\nconst region = String(policy.holiday_region || '').trim();\nconst holidays = {};\nfor (const h of holidayItems.flatMap(i => Array.isArray(i.data) ? i.data : (i.date ? [i] : [])))\n  if (!h.counties || (region && h.counties.includes(region))) holidays[h.date] = h.localName || h.name; // national + your region only\nconst holidaysLoaded = Object.keys(holidays).length > 0;\nconst workDays = String(policy.working_days || '1,2,3,4,5').split(',').map(Number); // 1 = Monday\nconst reasons = [];\nconst parse = s => { const m = String(s || '').match(/^(\\d{4})-(\\d{2})-(\\d{2})/); return m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])) : null; };\nconst start = parse(f.start_date), end = parse(f.end_date);\nconst today = parse($now.toFormat('yyyy-MM-dd'));\nlet days = 0; const skipped = [];\nif (!start || !end) reasons.push('The dates could not be read.');\nelse if (end < start) reasons.push('The last day is before the first day.');\nelse {\n  for (let d = new Date(start); d <= end; d.setUTCDate(d.getUTCDate() + 1)) {\n    const iso = d.toISOString().slice(0, 10), dow = d.getUTCDay() || 7;\n    if (!workDays.includes(dow)) continue;\n    if (holidays[iso]) { skipped.push(`${iso} ${holidays[iso]}`); continue; }\n    days++;\n  }\n  if (f.half_day !== 'No' && days > 0) days -= 0.5;\n  if (days <= 0) reasons.push('Those dates contain no working days.');\n  const back = f.leave_type === 'Sick leave' ? 14 : 0;\n  if (start < new Date(today.getTime() - back * 864e5)) reasons.push(f.leave_type === 'Sick leave' ? 'Sick leave can only be recorded up to 14 days back.' : 'The first day is in the past.');\n  if ((end - start) / 864e5 > 62) reasons.push('Requests longer than two months need to go to HR directly.');\n}\nif (!emp.email) reasons.push('Your email is not in the employee list. Ask HR to add you.');\nconst allowance = Number(emp.annual_allowance) || 0, taken = Number(emp.days_taken) || 0;\nconst remaining = allowance - taken;\nif (emp.email && f.leave_type === 'Annual leave' && days > remaining) reasons.push(`You have ${remaining} day(s) of annual leave left but asked for ${days}.`);\nconst id = 'LR-' + $now.toFormat('yyyyMMdd-HHmmss');\nreturn [{ json: { request_id: id, submitted: $now.toFormat('yyyy-MM-dd HH:mm'), employee: emp.name || f.email, email: String(f.email).toLowerCase(),\n  team: emp.team || '', manager_email: emp.manager_email || policy.hr_email, leave_type: f.leave_type, start_date: f.start_date, end_date: f.end_date,\n  half_day: f.half_day, working_days: days, reason: f.reason || '', allowance, days_taken: taken, remaining_before: remaining,\n  remaining_after: f.leave_type === 'Annual leave' ? remaining - days : remaining, holidays_skipped: skipped.join(', '),\n  holidays_checked: holidaysLoaded, valid: reasons.length === 0, problems: reasons.join(' ') } }];"
      },
