      "parameters": {
        "jsCode": "// Which years of public holidays do we need? (requests can span New Year)\nconst f = $('Leave request form').first().json;\nconst y1 = Number(String(f.start_date).slice(0, 4)), y2 = Number(String(f.end_date).slice(0, 4));\nconst years = [...new Set([y1, y2].filter(y => y > 2000 && y < 2100))];\nreturn (years.length ? years : [new Date().getFullYear()]).map(year => ({ json: { year } }));"
      },
      "id": "8db4eae5-0e64-551b-b08f-cf1fb14646fb",
      "name": "List holiday years",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://date.nager.at/api/v3/PublicHolidays/{{ $json.year }}/{{ $('Set leave policy').first().json.country_code }}",
