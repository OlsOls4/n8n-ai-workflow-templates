    {
      "parameters": {
        "content": "## 2. Pull GA4 data",
        "height": 300,
        "width": 940,
        "color": 7
      },
      "id": "bf55df7d-6920-5d8d-b8f4-f5b40c20c6d0",
      "name": "Section: Pull GA4 data",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        380,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Totals for this week vs last week, plus top pages and sources\nconst sum = (rows, k) => rows.reduce((t, r) => t + (Number(r[k]) || 0), 0);\nconst cur = $('Get this week\\'s traffic').all().map(i => i.json);\nconst prev = $('Get last week\\'s traffic').all().map(i => i.json);\nconst metrics = ['totalUsers', 'newUsers', 'sessions', 'screenPageViews', 'keyEvents'];\nconst labels = { totalUsers: 'Users', newUsers: 'New users', sessions: 'Sessions', screenPageViews: 'Page views', keyEvents: 'Key events' };\nconst kpis = metrics.map(m => { const c = sum(cur, m), p = sum(prev, m);\n  return { metric: labels[m], current: Math.round(c), previous: Math.round(p), change_pct: p ? Math.round(1000 * (c - p) / p) / 10 : null }; });\nconst engaged = sum(cur, 'engagedSessions'), sess = sum(cur, 'sessions');\nconst top_pages = $('Get top pages').all().map(i => i.json).slice(0, 8).map(r => ({ page: r.pagePath, views: Number(r.screenPageViews) }));\nconst top_sources = $('Get top traffic sources').all().map(i => i.json).slice(0, 8).map(r => ({ source: r.sessionSourceMedium, sessions: Number(r.sessions) }));\nreturn [{ json: { kpis, engagement_rate_pct: sess ? Math.round(1000 * engaged / sess) / 10 : null, top_pages, top_sources } }];"
      },
      "id": "0dcb1627-ffe5-5a53-a030-67aaec5b54d6",
      "name": "Calculate week-over-week changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        -80
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a web analytics consultant writing a weekly note for a busy small-business owner. Use ONLY the numbers below; do not invent causes you cannot see in the data. Mention percentages from the data.\n\nSite: {{ $('Set report settings').first().json.site_name }}\nKPIs (this week vs last week): {{ JSON.stringify($json.kpis) }}\nEngagement rate this week: {{ $json.engagement_rate_pct }}%\nTop pages: {{ JSON.stringify($json.top_pages) }}\nTop sources: {{ JSON.stringify($json.top_sources) }}\n\nReturn a headline under 12 words, 3 wins, up to 3 concerns and 3 specific next actions (each under 20 words).",
        "hasOutputParser": true
      },
      "id": "5adefca9-6a2e-52ba-9e76-2682c957a737",
      "name": "Write insights with AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1700,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "d186e145-5aed-5f92-afb4-6b92ea1b57cb",
      "name": "Gemini 3.5 Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1700,
        140
      ],
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"headline\": \"Traffic up 12% with organic search leading the growth\",\n  \"wins\": [\n    \"Organic sessions +18% week over week\"\n  ],\n  \"concerns\": [\n    \"Engagement rate fell 3 points\"\n  ],\n  \"actions\": [\n    \"Refresh the top landing page's call to action\"\n  ]\n}"
      },
      "id": "e7502ff4-47ae-5c9f-8519-2e53721f980b",
      "name": "Insights format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1840,
        140
      ]
    },
    {
      "parameters": {
        "content": "## 3. Compare and write insights",
        "height": 500,
        "width": 580,
        "color": 7
      },
      "id": "3e81a7bb-b172-52d7-af5b-e510bfc0f1e3",
      "name": "Section: Compare and write insights",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1400,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Branded HTML email: KPI table with coloured deltas, AI insights, top pages and sources\nconst e = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst d = $('Calculate week-over-week changes').first().json; const ai = $json.output; const s = $('Set report settings').first().json;\nconst delta = v => v === null ? '–' : `<span style=\"color:${v >= 0 ? '#1a7f37' : '#cf222e'}\">${v >= 0 ? '▲' : '▼'} ${Math.abs(v)}%</span>`;\nconst rows = d.kpis.map(k => `<tr><td style=\"padding:6px 12px\">${k.metric}</td><td style=\"padding:6px 12px;text-align:right\"><b>${k.current.toLocaleString()}</b></td><td style=\"padding:6px 12px;text-align:right;color:#666\">${k.previous.toLocaleString()}</td><td style=\"padding:6px 12px;text-align:right\">${delta(k.change_pct)}</td></tr>`).join('');\nconst li = a => (a || []).map(x => `<li>${e(x)}</li>`).join('');\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:640px\"><h2 style=\"color:${s.brand_color || '#111'}\">${e(s.site_name)}: weekly report</h2>` +\n `<p style=\"font-size:16px\"><b>${e(ai.headline)}</b></p><table style=\"border-collapse:collapse;width:100%;border:1px solid #eee\"><tr style=\"background:#f6f8fa\"><th align=\"left\" style=\"padding:6px 12px\">Metric</th><th align=\"right\" style=\"padding:6px 12px\">This week</th><th align=\"right\" style=\"padding:6px 12px\">Last week</th><th align=\"right\" style=\"padding:6px 12px\">Change</th></tr>${rows}</table>` +\n `<p>Engagement rate: ${d.engagement_rate_pct ?? '–'}%</p><h3>Wins</h3><ul>${li(ai.wins)}</ul><h3>Watch</h3><ul>${li(ai.concerns)}</ul><h3>Next actions</h3><ul>${li(ai.actions)}</ul>` +\n `<h3>Top pages</h3><ol>${d.top_pages.map(p => `<li>${e(p.page)} (${p.views})</li>`).join('')}</ol><h3>Top sources</h3><ol>${d.top_sources.map(p => `<li>${e(p.source)} (${p.sessions})</li>`).join('')}</ol></div>`;\nreturn [{ json: { html, subject: `${s.site_name} weekly report: ${ai.headline}` } }];"
      },
