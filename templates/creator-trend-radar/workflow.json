    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst ideas = $('Skip ideas already suggested').all().map(i => i.json);\nconst icon = { today: '🔥', 'this week': '📅', evergreen: '🌱' };\nlet text = `<b>💡 ${ideas.length} video idea${ideas.length === 1 ? '' : 's'} for today</b>\\n\\n`;\nideas.forEach((i, n) => { text += `${n + 1}. ${icon[i.urgency] || '•'} <b>${esc(i.topic)}</b> (${esc(i.format)}, ${i.relevance}/10)\\n🎣 ${esc(i.hook)}\\n📈 ${esc(i.why_now)}\\n\\n`; });\nreturn [{ json: { text: text.slice(0, 4000) } }];"
      },
