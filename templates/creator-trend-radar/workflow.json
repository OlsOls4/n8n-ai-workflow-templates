    {
      "parameters": {
        "jsCode": "// Merge Google Trends and competitor uploads into prompt-ready text. Broken feeds are skipped.\nconst s = $('Set radar settings').first().json;\nconst safe = n => { try { return $(n).all().map(i => i.json).filter(j => !j.error); } catch (e) { return []; } };\nconst trends = safe('Read Google Trends daily feed').filter(t => t.title).slice(0, 25).map(t => {\n  const news = [].concat(t['ht:news_item_title'] || []).slice(0, 2).join(' | ');\n  return `- ${t.title} (${t['ht:approx_traffic'] || '?'} searches)${news ? ': ' + news : ''}`;\n});\nconst since = Date.now() - (Number(s.lookback_hours) || 72) * 3600e3;\nconst uploads = safe('Read competitor uploads').filter(v => v.link && Date.parse(v.isoDate || v.pubDate) >= since).slice(0, 25)\n  .map(v => `- ${v.author || 'channel'}: ${v.title}`);\nreturn [{ json: { ...s, trends_text: trends.join('\\n'), competitor_text: uploads.join('\\n'),\n  trend_count: trends.length, upload_count: uploads.length } }];"
      },
      "id": "0ac84ed6-6728-5ce8-80a3-4c3a24245e80",
      "name": "Collect signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        0
      ],
      "executeOnce": true
    },
