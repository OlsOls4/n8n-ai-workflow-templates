      "name": "Gemini 3.5 Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1700,
        220
      ],
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"ideas\": [\n    {\n      \"topic\": \"Why everyone is talking about the new UK energy price cap\",\n      \"hook\": \"Your energy bill changes next month. Here's the 30-second version.\",\n      \"format\": \"short\",\n      \"angle\": \"Explain what changes for a typical flat in plain numbers\",\n      \"why_now\": \"Trending in GB with 200K+ searches today\",\n      \"source\": \"Google Trends: energy price cap\",\n      \"relevance\": 8,\n      \"urgency\": \"today\"\n    }\n  ]\n}"
      },
      "id": "fbc242a9-577a-58bc-a2b4-03462da3cbe8",
      "name": "Ideas JSON format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1840,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep ideas above the relevance bar, rank by relevance and urgency, cap the list\nconst s = $('Set radar settings').first().json;\nconst w = { today: 3, 'this week': 2, evergreen: 1 };\nconst ideas = ($json.output?.ideas || [])\n  .filter(i => i.topic && Number(i.relevance) >= (Number(s.min_relevance) || 6))\n  .map(i => ({ ...i, relevance: Number(i.relevance), score: Number(i.relevance) * 10 + (w[i.urgency] || 1) * 5 }))\n  .sort((a, b) => b.score - a.score).slice(0, Number(s.max_ideas) || 5);\nconst key = t => String(t).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\nreturn ideas.map(i => ({ json: { idea_id: 'tr-' + key(i.topic).split(' ').slice(0, 8).join('-'), found_on: $now.toFormat('yyyy-MM-dd'),\n  topic: i.topic, hook: i.hook, format: i.format, angle: i.angle, why_now: i.why_now, source: i.source,\n  relevance: i.relevance, urgency: i.urgency, audience: s.audience, status: 'new' } }));"
      },
      "id": "eef058fe-df10-5f87-992c-fbca21e19047",
      "name": "Rank ideas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        0
      ]
    },
