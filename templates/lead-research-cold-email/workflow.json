    {
      "parameters": {
        "content": "## 1. Load leads\nLeads without a status are processed, up to max_leads_per_run.",
        "height": 330,
        "width": 1220,
        "color": 7
      },
      "id": "87f02692-2d6b-5aca-a10e-8540fa8170cd",
      "name": "Section: 1. Load leads",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -150
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write the opening line of a cold email to this lead. The pitch is written separately, so the line must stand on its own and lead naturally into a short pitch for: {{ $('Set your offer').first().json.what_you_sell }}\n\nLead:\nName: {{ $json.first_name }} {{ $json.last_name }}\nRole: {{ $json.role }}\nCompany: {{ $json.company }}\nWebsite: {{ $json.website }}\nNotes / research: {{ $json.notes || 'none' }}\n\nRules:\n- One sentence, max 25 words, about them (their company, a recent change, something specific in the notes), not about you.\n- Only use facts given above. If there is nothing specific, write an honest line about their role or industry and set confidence to \"low\".\n- No flattery clichés (\"I came across your profile\", \"I hope this email finds you well\", \"I love what you're doing\"), no questions, no emojis.",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 5,
          "delayBetweenBatches": 2000
        }
      },
      "id": "c24ea8ee-8009-57fc-819d-89363ced4f79",
      "name": "Write opening line with AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1350,
        0
      ]
    },
    {
      "parameters": {
