        "jsCode": "// Build a plain-text digest of everything triaged in the lookback window, high priority first\nconst s = $('Set digest settings').first().json;\nconst since = Date.now() - (Number(s.lookback_hours) || 24) * 3600000;\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r.logged_at && Date.parse(String(r.logged_at).replace(' ', 'T')) >= since);\nif (!rows.length) return [{ json: { subject: '[AI Triage] Digest: inbox was quiet', text: 'No new emails were triaged in the last ' + (s.lookback_hours || 24) + ' hours.' } }];\nconst rank = { high: 0, medium: 1, low: 2 };\nrows.sort((a, b) => (rank[a.priority] ?? 3) - (rank[b.priority] ?? 3));\nconst count = {};\nfor (const r of rows) count[r.category] = (count[r.category] || 0) + 1;\nconst archived = rows.filter(r => r.archived === 'yes').length;\nconst important = rows.filter(r => r.priority !== 'low' && !['newsletter', 'promotion', 'receipt'].includes(r.category));\nconst lines = [rows.length + ' emails triaged (' + Object.entries(count).map(([k, v]) => k + ': ' + v).join(', ') + '), ' + archived + ' archived.', ''];\nfor (const r of important.slice(0, 25)) lines.push((r.priority === 'high' ? '[HIGH] ' : '') + r.subject + '\\n  ' + r.from + '\\n  ' + r.summary + '\\n  ' + r.gmail_link + '\\n');\nif (!important.length) lines.push('Nothing needs your attention.');\nreturn [{ json: { subject: '[AI Triage] Digest: ' + rows.length + ' emails, ' + important.length + ' need attention', text: lines.join('\\n') } }];"
      },
