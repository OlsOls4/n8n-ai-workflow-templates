    {
      "parameters": {
        "jsCode": "// Map each AI category (and high priority) to the ID of a Gmail label you created, e.g. \"AI/Needs reply\"\n// VIP senders and urgent keywords force high priority; categories in archive_categories are archived unless high priority\nconst s = $('Set your labels and context').first().json;\nconst prefix = s.label_prefix || 'AI/';\nconst NAMES = { needs_reply: 'Needs reply', action: 'Action', fyi: 'FYI', newsletter: 'Newsletter', receipt: 'Receipt', promotion: 'Promotion' };\nconst archiveCats = String(s.archive_categories || '').toLowerCase().split(',').map(x => x.trim()).filter(Boolean);\nconst ids = {};\nfor (const l of $input.all()) ids[String(l.json.name || '').toLowerCase()] = l.json.id;\nconst emails = $('Clean email text and flag VIPs').all();\nreturn $('Classify email with AI').all().map((item, i) => {\n  const ai = item.json.output || {};\n  const { body, ...e } = emails[i].json;\n  const category = NAMES[ai.category] ? ai.category : 'fyi';\n  const forced = e.is_vip || Boolean(e.urgent_hit);\n  const priority = forced ? 'high' : (ai.priority || 'low');\n  const wanted = [prefix + NAMES[category]];\n  if (priority === 'high') wanted.push(prefix + 'High priority');\n  return { json: { ...e, category, priority, summary: ai.summary || '', needs_reply: ai.needs_reply === true,\n    why_high: e.is_vip ? 'VIP sender' : (e.urgent_hit ? 'keyword: ' + e.urgent_hit : (ai.reason || '')),\n    archive: archiveCats.includes(category) && priority !== 'high',\n    alert: priority === 'high' && (ai.needs_reply === true || category === 'action' || forced),\n    label_ids: wanted.map(n => ids[n.toLowerCase()]).filter(Boolean),\n    missing_labels: wanted.filter(n => !ids[n.toLowerCase()]) } };\n});"
      },
      "id": "2bd1806e-fd41-5551-8a13-5ada5cd424c8",
      "name": "Match AI category to label IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1550,
        0
      ]
