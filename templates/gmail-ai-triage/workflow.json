      "id": "787e8d4d-a056-5065-bb60-4b3223901710",
      "name": "Set your labels and context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Compact each email (Gmail Trigger with Simplify off), cut quoted history and flag VIP senders and urgent keywords from your settings\nconst s = $('Set your labels and context').first().json;\nconst max = Number(s.max_body_chars) || 4000;\nreturn $('Check Gmail for new emails').all().map(({ json: m }) => {\n  const from = (m.from && m.from.value && m.from.value[0]) || {};\n  let body = String(m.text || m.snippet || '');\n  body = body.split(/\\r?\\n/).filter(l => !l.trim().startsWith('>')).join('\\n');\n  body = body.replace(/\\n\\s*On [^\\n]{5,200}wrote:[\\s\\S]*$/, '');\n  body = body.replace(/\\n{3,}/g, '\\n\\n').trim().slice(0, max);\n  const headers = m.headers || {};\n  const list = v => String(v || '').toLowerCase().split(',').map(x => x.trim()).filter(Boolean);\n  const email = String(from.address || '').toLowerCase();\n  const subject = m.subject || '(no subject)';\n  const is_vip = list(s.vip_senders).some(v => v.startsWith('@') ? email.endsWith(v) : email === v);\n  const urgent_hit = list(s.urgent_keywords).find(k => (subject + ' ' + body).toLowerCase().includes(k)) || '';\n  return { json: {\n    message_id: m.id, thread_id: m.threadId,\n    from_name: from.name || '', from_email: email,\n    subject, date: m.date || '', is_vip, urgent_hit,\n    has_unsubscribe_link: Boolean(headers['list-unsubscribe']),\n    body,\n  } };\n});"
      },
      "id": "a2e0452e-217f-55ea-b9f1-bad908a7be5e",
      "name": "Clean email text and flag VIPs",
      "type": "n8n-nodes-base.code",
