      "id": "d0722ecb-469c-5c10-be72-d27b594758a5",
      "name": "Read the log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        4060,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
