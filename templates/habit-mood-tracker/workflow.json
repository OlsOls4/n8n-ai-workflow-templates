    {
      "parameters": {
        "jsCode": "// Per-habit stats over the last 7 days: done count, completion %, current streak, mood with vs without the habit\nconst tz = 'Europe/London';\nconst today = DateTime.now().setZone(tz).startOf('day');\nconst days = [...Array(7)].map((_, i) => today.minus({ days: i }).toFormat('yyyy-MM-dd'));\nconst habits = $('Read habits for stats').all().map(i => i.json).filter(h => h.habit_id && String(h.active).toLowerCase() !== 'no');\nconst log = $('Read log for stats').all().map(i => i.json).filter(r => r.log_id);\nconst val = (d, id) => { const r = log.find(x => String(x.date) === d && String(x.habit_id) === String(id)); return r ? String(r.value) : ''; };\nconst mood = d => Number(val(d, 'mood')) || null;\nconst avg = a => a.length ? Math.round(a.reduce((x, y) => x + y, 0) / a.length * 10) / 10 : null;\nconst stats = habits.map(h => {\n  const done = days.filter(d => val(d, h.habit_id) === 'done');\n  let streak = 0;\n  for (const d of days) { const v = val(d, h.habit_id); if (v === 'done') streak++; else if (v === 'rest' || (d === days[0] && !v)) continue; else break; }\n  const rest = days.filter(d => val(d, h.habit_id) === 'rest').length;\n  const target = Number(h.target_per_week) || 7;\n  const withH = done.map(mood).filter(Boolean), without = days.filter(d => !done.includes(d) && val(d, h.habit_id) !== 'rest').map(mood).filter(Boolean);\n  const mw = avg(withH), mo = avg(without);\n  // Only call it a pattern with 3+ mood days on each side and a gap of 0.5+ (computed here so the AI never over-reads noise)\n  const pattern = withH.length >= 3 && without.length >= 3 && Math.abs(mw - mo) >= 0.5\n    ? `mood ${mw} on days with \"${h.habit}\" vs ${mo} without` : '';\n  return { habit: `${h.emoji || '•'} ${h.habit}`, done: done.length, of: days.length,\n    pct: Math.round(done.length / Math.max(1, days.length - rest) * 100), rest_days: rest, streak, target_per_week: target,\n    on_target: done.length >= Math.round(target * (days.length - rest) / 7), mood_with: mw, mood_without: mo, pattern };\n});\nconst moods = days.map(mood).filter(Boolean);\nconst text = stats.map(s => `${s.habit}: ${s.done}/${s.of} (${s.pct}%)${s.streak > 1 ? ` · 🔥 ${s.streak}-day streak` : ''}${s.on_target ? ' ✅' : ''}`).join('\\n');\nreturn [{ json: { period_days: days.length, stats, stats_text: text || 'No habits set up yet.',\n  mood_avg: avg(moods), mood_days: moods.length, from: days[days.length - 1], to: days[0] } }];"
      },
      "id": "8d246401-2f1b-5eb2-994f-63923174da60",
      "name": "Calculate 7-day stats",
