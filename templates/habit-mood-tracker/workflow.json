      "parameters": {
        "jsCode": "// Buttons: m|date|1-5 (mood) and h|date|habit_id|done/missed/rest. Messages: /stats, /help or (Pro) a journal line.\nconst u = $json;\nconst owner = $('Config').first().json.telegram_chat_id;\nif (u.callback_query) {\n  const q = u.callback_query;\n  const [t, date, a, b] = String(q.data || '').split('|');\n  const base = { chat_id: q.message?.chat?.id, message_id: q.message?.message_id, query_id: q.id, question: q.message?.text || '' };\n  if (t === 'm') return [{ json: { ...base, kind: 'answer', log_id: `${date}|mood`, date, habit_id: 'mood', value: a, label: `Mood ${a}/5` } }];\n  if (t === 'h') return [{ json: { ...base, kind: 'answer', log_id: `${date}|${a}`, date, habit_id: a, value: b,\n    label: { done: '✅ Done', missed: '❌ Not today', rest: '💤 Rest day' }[b] || b } }];\n  return [{ json: { ...base, kind: 'ignore' } }];\n}\nconst m = u.message || {};\nconst text = String(m.text || '').trim();\nconst kind = /^\\/stats\\b/i.test(text) ? 'stats' : (text && !text.startsWith('/') ? 'journal' : 'help');\nreturn [{ json: { kind, chat_id: m.chat?.id, text, allowed: owner === 'YOUR_TELEGRAM_CHAT_ID' || String(m.chat?.id) === owner,\n  date: DateTime.fromSeconds(m.date || Math.floor(Date.now() / 1000)).toFormat('yyyy-MM-dd') } }];"
      },
