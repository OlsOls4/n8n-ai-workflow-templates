        "jsCode": "const s = $('Set tracker settings').first().json;\nconst d = DateTime.now().setZone(s.timezone).toFormat('yyyy-MM-dd');\nreturn $input.all().map(i => i.json).filter(h => h.habit_id && String(h.active).toLowerCase() !== 'no')\n  .map(h => ({ json: { chat_id: s.chat_id, text: `${h.emoji || '•'} ${h.habit}?`,\n    done: `h|${d}|${String(h.habit_id).slice(0, 30)}|done`, missed: `h|${d}|${String(h.habit_id).slice(0, 30)}|missed`,\n    rest: `h|${d}|${String(h.habit_id).slice(0, 30)}|rest` } }));"
