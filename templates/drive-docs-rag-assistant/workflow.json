    {
      "parameters": {
        "url": "={{ 'https://www.googleapis.com/drive/v3/files?q=' + encodeURIComponent(\"'\" + $json.drive_folder_id + \"' in parents and trashed = false\") + '&fields=files(id,name,mimeType,modifiedTime,webViewLink,size)&pageSize=1000&supportsAllDrives=true&includeItemsFromAllDrives=true' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 60000
        }
      },
      "id": "6e3ea719-6189-56fa-9d5a-9d5426749fb4",
      "name": "List files in the folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        380,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Supported: PDF, Google Docs / Slides / Sheets (exported as text or CSV), plain text, Markdown, CSV.\nconst EXPORT = { 'application/vnd.google-apps.document': 'text/plain', 'application/vnd.google-apps.presentation': 'text/plain',\n  'application/vnd.google-apps.spreadsheet': 'text/csv' };\nconst TEXT = ['text/plain', 'text/markdown', 'text/csv', 'text/x-markdown', 'application/pdf'];\nfunction plan(f) {\n  const base = 'https://www.googleapis.com/drive/v3/files/' + f.id;\n  if (EXPORT[f.mimeType]) return { ...f, kind: 'text', download_url: base + '/export?mimeType=' + encodeURIComponent(EXPORT[f.mimeType]) };\n  if (TEXT.includes(f.mimeType) || /\\.(md|txt|csv)$/i.test(f.name)) return { ...f, kind: f.mimeType === 'application/pdf' ? 'pdf' : 'text', download_url: base + '?alt=media&supportsAllDrives=true' };\n  return null;\n}\n\nreturn ($json.files || []).map(plan).filter(Boolean).map(f => ({ json: { file_id: f.id, name: f.name, mimeType: f.mimeType,\n  link: f.webViewLink || ('https://drive.google.com/file/d/' + f.id + '/view'), download_url: f.download_url } }));"
      },
      "id": "f2f6d9fc-9b3d-5912-88a9-a0f65f371619",
      "name": "Keep supported files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.download_url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
