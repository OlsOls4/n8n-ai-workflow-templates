        "content": "## 1. Receive the message and load the FAQ",
        "height": 300,
        "width": 940,
        "color": 7
      },
      "id": "072df128-cabb-57e8-949f-7cb083a1261d",
      "name": "Section: Receive the message and load the FAQ",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -120
