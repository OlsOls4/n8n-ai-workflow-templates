    {
      "parameters": {
        "jsCode": "// Build the knowledge base from the FAQ sheet and spot contact details in the message\nconst s = $('Set business details').first().json;\nconst chat = $('When a visitor sends a chat message').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.question && r.answer && String(r.active ?? 'yes').toLowerCase() !== 'no');\nlet kb = rows.map(r => `[${r.category || 'General'}] Q: ${String(r.question).trim()}\\nA: ${String(r.answer).trim()}`).join('\\n\\n');\nif (kb.length > 15000) kb = kb.slice(0, 15000);\nconst msg = String(chat.chatInput || '').slice(0, 1000);\nconst email = (msg.match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/) || [])[0] || '';\nconst phone = (msg.match(/(\\+?\\d[\\d\\s().-]{7,}\\d)/) || [])[0] || '';\nreturn [{ json: { sessionId: chat.sessionId, message: msg, too_long: String(chat.chatInput || '').length > 1000,\n  knowledge: kb || 'No FAQ entries yet.', faq_count: rows.length, email_in_message: email, phone_in_message: phone.trim(), business: s } }];"
      },
      "id": "b3960a40-8d3d-5f3e-b68a-e3c5d467a8f4",
