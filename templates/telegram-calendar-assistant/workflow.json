      "parameters": {
        "content": "## 3. Let the agent use Calendar and Tasks",
        "height": 560,
        "width": 1060,
        "color": 7
      },
      "id": "fbccc4ff-82a3-591c-b33f-9050b9efab86",
      "name": "Section: Let the agent use Calendar and Tasks",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1840,
        -120
      ]
