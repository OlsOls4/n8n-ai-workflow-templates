    {
      "parameters": {
        "jsCode": "// Plain-text reply, markdown stripped, split under Telegram's 4096 limit. Falls back politely if the agent failed.\nconst req = $('Calendar and tasks assistant').first().json;\nlet text = String(req.output || '').replace(/\\*\\*(.+?)\\*\\*/g, '$1').replace(/^#+\\s*/gm, '').trim();\nif (!text) text = \"Sorry, I couldn't do that just now. Please try again in a minute.\";\nconst heard = $('Use transcript as request').isExecuted ? `🎙 \"${$('Use transcript as request').first().json.request}\"\\n\\n` : '';\ntext = heard + text;\nconst parts = [];\nfor (let i = 0; i < text.length; i += 3900) parts.push(text.slice(i, i + 3900));\nconst chatId = $('Set assistant settings').first().json.message.chat.id;\nreturn parts.map(t => ({ json: { chat_id: chatId, text: t } }));"
      },
      "id": "2427bee9-7a56-5014-9219-41b15ba40b5a",
      "name": "Format reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3040,
        0
      ]
    },
