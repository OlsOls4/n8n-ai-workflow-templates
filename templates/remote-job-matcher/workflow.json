      "parameters": {
        "promptType": "define",
        "text": "=You are an experienced technical recruiter. Score how well this remote job matches the candidate's CV and preferences.\n\nCandidate CV and preferences:\n{{ $('Set your CV and preferences').first().json.cv_text }}\n\nJob:\nTitle: {{ $json.title }}\nCompany: {{ $json.company }}\nLocation / time zone: {{ $json.location || 'not stated' }}\nSalary: {{ $json.salary || 'not stated' }}\nTags: {{ $json.tags }}\nDescription: {{ $json.description }}\n\nScoring guide: 90-100 near-perfect fit, 70-89 strong fit worth applying, 50-69 partial fit, below 50 poor fit. Lower the score sharply if the location or time zone rules the candidate out, or if the seniority is clearly wrong.",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 4,
          "delayBetweenBatches": 30000
        }
      },
