    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "265b2683-6961-5a87-ad02-94a89815fefa",
      "name": "Wait for all sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        680,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise the three feeds, keep recent jobs whose title or tags match a keyword, newest first, capped per run\nconst s = $('Set your CV and preferences').first().json;\nconst keywords = String(s.keywords || '').toLowerCase().split(',').map(k => k.trim()).filter(Boolean);\nconst maxAgeMs = (Number(s.max_age_days) || 7) * 86400000;\nconst strip = h => String(h || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')\n  .replace(/&#39;|&rsquo;/g, \"'\").replace(/&quot;/g, '\"').replace(/\\s+/g, ' ').trim();\nconst safe = name => { try { return $(name).all().map(i => i.json).filter(j => !j.error); } catch (e) { return []; } };\n\nconst jobs = [];\nfor (const r of safe('Fetch Remotive jobs')) {\n  for (const j of (r.jobs || [])) jobs.push({\n    source: 'Remotive', title: j.title, company: j.company_name, url: j.url,\n    location: j.candidate_required_location, salary: j.salary, tags: [j.category, ...(j.tags || [])].join(', '),\n    published: j.publication_date, description: strip(j.description),\n  });\n}\nfor (const j of safe('Fetch Remote OK jobs')) {\n  if (!j.position) continue; // first element is Remote OK's legal notice\n  const sal = Number(j.salary_min) ? `$${j.salary_min}-${j.salary_max}` : '';\n  jobs.push({\n    source: 'Remote OK', title: j.position, company: j.company, url: j.url, location: j.location,\n    salary: sal, tags: (j.tags || []).join(', '), published: j.date, description: strip(j.description),\n  });\n}\nfor (const j of safe('Fetch We Work Remotely jobs')) {\n  if (!j.link) continue;\n  const [company, ...rest] = String(j.title || '').split(': ');\n  jobs.push({\n    source: 'We Work Remotely', title: rest.join(': ') || j.title, company, url: j.link,\n    location: j.region || '', salary: '', tags: [j.category, j.skills].filter(Boolean).join(', '),\n    published: j.isoDate || j.pubDate, description: strip(j.content || j.contentSnippet),\n  });\n}\n\nconst now = Date.now();\nconst matches = jobs\n  .filter(j => j.url && j.title)\n  .filter(j => { const t = Date.parse(j.published); return isNaN(t) || now - t <= maxAgeMs; })\n  .filter(j => {\n    if (!keywords.length) return true;\n    const hay = `${j.title} ${j.tags}`.toLowerCase(); // title + tags only: descriptions match almost anything\n    return keywords.some(k => hay.includes(k));\n  })\n  .sort((a, b) => (Date.parse(b.published) || 0) - (Date.parse(a.published) || 0))\n  .slice(0, Number(s.max_jobs_per_run) || 25)\n  .map(j => ({ ...j, description: j.description.slice(0, 3500) }));\n\nreturn matches.map(j => ({ json: j }));"
      },
