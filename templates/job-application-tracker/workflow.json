    {
      "parameters": {
        "jsCode": "// Who to chase this week: applications with no news for N+ days, deadlines in the next 7 days, and this week's changes\nconst cfg = $('Set summary settings').first().json;\nconst days = Number(cfg.follow_up_after_days) || 7;\nconst rows = $input.all().map(i => i.json).filter(r => r.application_key);\nconst now = DateTime.now();\nconst parse = v => { const d = DateTime.fromFormat(String(v || ''), 'yyyy-MM-dd HH:mm'); return d.isValid ? d : DateTime.fromISO(String(v || '')); };\nconst age = r => { const d = parse(r.last_update); return d.isValid ? Math.floor(now.diff(d, 'days').days) : null; };\nconst esc = t => String(t ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\nconst link = r => r.gmail_link ? ` <a href=\"${r.gmail_link}\">open thread</a>` : '';\nconst waiting = rows.filter(r => ['applied', 'recruiter_outreach', 'assessment'].includes(r.status) && age(r) !== null && age(r) >= days)\n  .sort((a, b) => age(b) - age(a));\nconst soon = rows.filter(r => { const d = DateTime.fromISO(String(r.deadline || '')); return d.isValid && d >= now.startOf('day') && d <= now.plus({ days: 7 }); })\n  .sort((a, b) => String(a.deadline).localeCompare(String(b.deadline)));\nconst changed = rows.filter(r => age(r) !== null && age(r) < 7 && !['applied', 'other'].includes(r.status));\nconst count = st => rows.filter(r => r.status === st).length;\nconst active = rows.filter(r => !['rejected', 'other'].includes(r.status)).length;\nconst responded = rows.filter(r => !['applied', 'other'].includes(r.status)).length;\nconst li = (r, extra) => `<li><b>${esc(r.company)}</b> – ${esc(r.role)} (${esc(r.status)}${extra})${link(r)}</li>`;\nconst html = `<h2>Your job search this week</h2>\n<p>${rows.length} applications, ${active} still open. Response rate ${rows.length ? Math.round(100 * responded / rows.length) : 0}%.<br>\nInterviews ${count('interview')} · Tests ${count('assessment')} · Offers ${count('offer')} · Rejections ${count('rejected')}</p>\n<h3>⏰ Deadlines in the next 7 days (${soon.length})</h3><ul>${soon.map(r => li(r, ', due ' + esc(r.deadline))).join('') || '<li>None</li>'}</ul>\n<h3>✉️ Worth a follow-up: no news for ${days}+ days (${waiting.length})</h3><ul>${waiting.map(r => li(r, ', ' + age(r) + ' days')).join('') || '<li>Nobody to chase this week</li>'}</ul>\n${waiting.length ? '<p>Tip: reply in the original thread with one line restating your interest and ask about the timeline.</p>' : ''}\n<h3>📬 Updates this week (${changed.length})</h3><ul>${changed.map(r => li(r, esc(r.next_step ? ': ' + r.next_step : ''))).join('') || '<li>No new replies</li>'}</ul>`;\nreturn [{ json: { to: cfg.your_email, subject: `Job search: ${waiting.length} to follow up, ${soon.length} deadline${soon.length === 1 ? '' : 's'} this week`,\n  html, applications: rows.length, follow_ups: waiting.length, deadlines: soon.length } }];"
      },
