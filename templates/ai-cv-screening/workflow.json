    {
      "parameters": {
        "content": "## 1. Receive the application",
        "height": 300,
        "width": 940,
        "color": 7
      },
      "id": "9af358b7-7934-5869-b90e-28883b0353f3",
      "name": "Section: Receive the application",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -120
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an experienced, fair recruiter screening CVs for one role.\n\nRole: {{ $json.job_title }}\nJob description: {{ $json.job_description }}\nMust-haves: {{ $json.must_haves }}\nNice-to-haves: {{ $json.nice_to_haves }}\n\nScoring rules:\n- Judge only job-relevant evidence in the CV: skills, experience, results, qualifications.\n- Ignore name, age, gender, ethnicity, nationality, religion, photos, marital status and any other protected characteristic. Never mention them.\n- score is 0-100. 80+ means clearly meets the must-haves; 50-79 partly; under 50 does not.\n- recommendation is one of: shortlist, maybe, reject.\n- Do not invent experience the CV does not show. If the CV text is empty or unreadable, score 0 and say so in summary.\n- Keep summary under 35 words, each list item under 8 words.\n\nCV text:\n{{ $json.cv_text }}",
        "hasOutputParser": true
      },
      "id": "93571fc5-1c6f-58fa-ab80-72c37738fb3f",
      "name": "Score CV against job description",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        920,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "652322ef-9e92-58a1-9c2f-4d41dfe6c772",
      "name": "Gemini 3.5 Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        920,
        140
      ],
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"score\": 78,\n  \"recommendation\": \"shortlist\",\n  \"summary\": \"Backend developer with 5 years of Python and AWS, led a small team.\",\n  \"must_haves_met\": [\n    \"Python\",\n    \"AWS\"\n  ],\n  \"must_haves_missing\": [\n    \"Kubernetes\"\n  ],\n  \"strengths\": [\n    \"5 years Python\",\n    \"Team lead experience\"\n  ],\n  \"gaps\": [\n    \"No Kubernetes\"\n  ],\n  \"years_experience\": 5,\n  \"red_flags\": [],\n  \"location\": \"Leeds, UK\"\n}"
      },
